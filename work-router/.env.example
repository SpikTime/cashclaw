# Copy this file to .env and fill values locally. Never commit .env.
NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3777
SOURCE_POLL_MINUTES=30
ACTIVE_HOURS_START=09:00
ACTIVE_HOURS_END=23:00
ACTIVE_TIMEZONE=Asia/Yekaterinburg

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://claude-api.io/v1
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_OUTPUT_TOKENS=750
LLM_DAILY_REQUEST_LIMIT=10
LLM_DAILY_BUDGET_USD=1
SOURCE_MAX_LLM_PER_CYCLE=3
SOURCE_MAX_CHEAP_LLM_PER_CYCLE=40
SOURCE_MAX_DEEP_LLM_PER_CYCLE=12
SOURCE_MIN_KEYWORD_MATCHES=2
SOURCE_MIN_BUDGET_RUB=1000
SOURCE_EXCLUDE_KEYWORDS=sales,cold calls,lead generation,spam,gambling
SKILL_KEYWORDS=typescript,javascript,react,node,api,automation,telegram,ai,website,testing,documentation

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_MODE=polling
NOTIFICATION_HOT_SCORE=70
NOTIFICATION_GOOD_SCORE=55
NOTIFICATION_MAYBE_SCORE=45
NOTIFICATION_MAX_ATTEMPTS=5

PLAYWRIGHT_CORE_PATH=
PLAYWRIGHT_EXECUTABLE_PATH=

GITHUB_TOKEN=
GITHUB_REPOSITORIES=

AUTOMATION_MODE=draft_only
REQUIRE_PROPOSAL_APPROVAL=true
REQUIRE_DELIVERY_APPROVAL=true
ENABLE_WALLET=false
ENABLE_MOLTLAUNCH=false

# Paid actions are fail-closed. A matching one-off approval is still required in code.
ALLOW_PAID_PROPOSALS=false
MAX_PAID_PROPOSAL_COST=0
MINIMUM_EXPECTED_NET_PROFIT=5
MINIMUM_EXPECTED_PROFIT_PER_AGENT_HOUR=3
MINIMUM_REWARD_TRUST_SCORE=55
MAXIMUM_TECHNICAL_RISK=65
MAXIMUM_PAYMENT_RISK=65
